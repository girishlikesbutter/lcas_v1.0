    style.border-radius: 8
  }
  e2: "Epoch 2\n~100 cands" {
    style.fill: "#AED6F1"
    style.stroke: "#2980B9"
    style.border-radius: 8
  }
  e3: "Epoch 3\n~100 cands" {
    style.fill: "#AED6F1"
    style.stroke: "#2980B9"
    style.border-radius: 8
  }
